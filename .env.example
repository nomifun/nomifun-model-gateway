# Copy to .env and fill operator-owned values. Never commit .env.
# Generate a random 32-byte base64 master key and back it up separately.
NMG_MASTER_KEY=
# First-start admin bootstrap only. Existing accounts are preserved.
NMG_ADMIN_EMAIL=
NMG_ADMIN_PASSWORD=

# Host access remains loopback; terminate public HTTPS in an operator proxy.
NMG_PORT=8789

# PostgreSQL Compose. Use a strong secret and encode URI password characters.
NMG_POSTGRES_USER=model_gateway
NMG_POSTGRES_DB=model_gateway
NMG_POSTGRES_PASSWORD=
# Example shape only; replace the placeholder. Host "database" is the Compose service.
# NMG_DB_DSN=postgres://model_gateway:<percent-encoded-password>@database:5432/model_gateway?sslmode=disable
NMG_DB_DSN=

# SQLite Compose sets /data/gateway.db itself and does not need PostgreSQL fields.
# Business settings, branding, models, channels and merchant credentials are
# configured through the authenticated admin console after bootstrap.
# Payments stay disabled until an operator configures and validates a provider.
